{
  "expo": {
    "name": "Luma",
    "slug": "vlc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/luma-icon.png",
    "scheme": "vlc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samspeedy.vlcmediaplayer",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "This app needs access to your media library to play your music and videos.",
        "NSMicrophoneUsageDescription": "This app needs microphone access for audio features.",
        "UIBackgroundModes": [
          "audio",
          "background-processing"
        ]
      }
    },
    "android": {
      "package": "com.samspeedy.vlcmediaplayer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/luma-mark.png",
        "backgroundColor": "#111214"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/luma-mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your media library.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/luma-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111214"
        }
      ],
      "expo-screen-orientation"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "544876cb-9a8a-4e7c-80a2-50e7465d51ab"
      }
    }
  }
}
